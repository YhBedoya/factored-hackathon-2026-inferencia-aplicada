# Official dictionary PDF contains the organizers' S3 access keys — never publish it
docs/official-docs/LATAM_Bank_Complete_Data_Dictionary.pdf

# Local secrets (S3 keys, LLM API keys)
.env

# Raw dataset downloaded from the organizers' bucket
data/

# Python
.venv/
__pycache__/
.ipynb_checkpoints/

# dbt-duckdb (pipeline/)
pipeline/dbt/target/
pipeline/dbt/logs/
# dbt's anonymous-usage-stats id, written locally because we pass
# --profiles-dir . instead of using the default ~/.dbt/
pipeline/dbt/.user.yml

# Claude Code: local worktrees and /wave-run ledgers (per-developer run state)
.claude/worktrees/
.claude/runs/*
!.claude/runs/.gitkeep

# Frontend (frontend/)
node_modules/
frontend/dist/
# Generated by the TanStack Router Vite plugin from src/routes/; regenerated
# on every dev/build, not diffed like the generated OpenAPI client (T14).
frontend/src/routeTree.gen.ts
# Playwright output (B5)
frontend/test-results/
frontend/playwright-report/
