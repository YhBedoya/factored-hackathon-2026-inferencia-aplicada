# Plain prod values (08 §9). The box's real `.env` is rendered from SSM
# (/swip/prod/) by infra/aws/render-env.sh at deploy time; empty values below
# are the SSM-sourced ones. No secrets, bucket names or emails here (R10).

APP_ENV=prod
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BANK=postgres
S3_PREFIX=data
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SESSION_TTL_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Elastic IP with dashes, e.g. 1-2-3-4.sslip.io (08 §8).
PUBLIC_HOST=

# --- SSM SecureString / SSM (values rendered at deploy time) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
JWT_SECRET=
IDENTITY_HMAC_KEY=
CREDENTIALS_SEED=
DEMO_OTP_CODE=
S3_BUCKET=
# Built from POSTGRES_USER / POSTGRES_PASSWORD by render-env.sh.
DATABASE_URL=
GOLDEN_DATABASE_URL=
REDIS_URL=
