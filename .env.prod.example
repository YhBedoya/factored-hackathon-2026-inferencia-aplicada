# Plain prod values (08 §9). The box's real `.env` is rendered from SSM
# (/swip/prod/) by infra/aws/render-env.sh at deploy time; empty values below
# are the SSM-sourced ones. No secrets, bucket names or emails here (R10).

APP_ENV=prod
LLM_PROVIDER=bedrock
# Cardy's agent node takes the turn first (ADR-035); off is the pipeline-only graph.
AGENT_ENABLED=true
# The project's region (08 §1, ADR-017 amended 2026-10-03). Bedrock is called
# through a `us.` cross-region inference profile from here.
AWS_REGION=us-east-2
BANK=postgres
S3_PREFIX=data
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SESSION_TTL_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
ANALYTICS_MOCK_ENABLED=true
# Judges' quick access (ADR-036): one-click login as the demo personas or admin,
# and DEMO_OTP_CODE shown on the landing page. On for the judging window only.
DEMO_QUICK_LOGIN=true
DEMO_REPO_URL=https://github.com/YhBedoya/factored-hackathon-2026-inferencia-aplicada
DEMO_DOCS_URL=https://github.com/YhBedoya/factored-hackathon-2026-inferencia-aplicada/blob/main/README.md
# Quick access makes admin public, so its DB reset route is off; reset on the
# box with `make demo-reset`.
DEMO_RESET_ENABLED=false

# Elastic IP with dashes, e.g. 1-2-3-4.sslip.io (08 §8).
PUBLIC_HOST=

# --- SSM SecureString / SSM (values rendered at deploy time) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
JWT_SECRET=
IDENTITY_HMAC_KEY=
CREDENTIALS_SEED=
PII_VAULT_KEY=
ANALYTICS_DB_PASSWORD=
DEMO_OTP_CODE=
S3_BUCKET=
# Built from POSTGRES_USER / POSTGRES_PASSWORD by render-env.sh, which skips
# empty placeholders, so these never reach `.env` empty.
DATABASE_URL=
GOLDEN_DATABASE_URL=
REDIS_URL=
