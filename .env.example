# Copied to `.env` by `make setup` (or `cp -n .env.example .env`). Real
# secrets never live in this file (R10) — it stays placeholders only.

# --- Postgres --------------------------------------------------------------
# Local values; work as-is for `make up`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host-side URLs (localhost:5432, for psql/alembic run from the host). The
# `backend` container overrides both to the `postgres` service hostname
# (see docker/docker-compose.base.yml).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/latam_app
GOLDEN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/latam_golden

# --- Redis -------------------------------------------------------------------
# Local value; works as-is for `make up`.
REDIS_URL=redis://localhost:6379/0

# --- S3 ingest (pipeline `make data`) ---------------------------------------
# Only read when SOURCE=s3 (the default). Unused when SOURCE=local:<path>.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
S3_BUCKET=
S3_PREFIX=

# Ingest source: `s3` (default) or `local:<path>` (e.g. `local:data`, a
# mirror of the S3 layout on disk). Also settable per-run as
# `make data SOURCE=local:data`, which overrides this value.
# SOURCE=

# Overrides the last source partition date used by the whole-week date
# offset (D11). Defaults to today when unset.
# LOAD_DATE=

# --- Observability -----------------------------------------------------------
# OTel collector endpoint. Empty disables exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- LLM (K1) ----------------------------------------------------------------
# `anthropic` until Bedrock is set up (ADR-028), then `bedrock`.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Bedrock only (reuses AWS_PROFILE above when set).
# AWS_REGION=
# Eval paraphrases only (backend/scripts/paraphrase_seeds.py, ADR-030). Never
# used by a served step.
OPENAI_API_KEY=
# Self-hosted Langfuse, optional (ADR-006).
# LANGFUSE_HOST=http://localhost:3100
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- Step-up (ADR-008) -------------------------------------------------------
# The demo OTP code a step-up-gated action verifies against. Never committed:
# the real value is shared with judges by email.
# Must be 6 digits (the chat's OTP field takes exactly 6).
DEMO_OTP_CODE=

# --- Identity / sessions (D2-A) -----------------------------------------------
# `dev`, `eval` or `prod`. `eval` mounts `/test-idp/sessions` (D8).
APP_ENV=dev
# `fake` (in-memory) or `postgres` read tools for the conversation registry.
BANK=postgres
# Filled by `make setup`, never committed (R10).
JWT_SECRET=
IDENTITY_HMAC_KEY=
CREDENTIALS_SEED=
# Fernet key for the PII vault and message content (D21). Filled by `make fill-secrets`.
# Losing it makes old vault rows and stored messages unreadable.
PII_VAULT_KEY=
# Password of the analytics worker's Postgres role (migration 0009). Filled by
# `make fill-secrets`; Compose builds ANALYTICS_DATABASE_URL from it.
ANALYTICS_DB_PASSWORD=
SESSION_TTL_MINUTES=60

# --- Reliability (D6-A) -------------------------------------------------------
# Fault injection and the LLM kill switch: set on the command line
# (`FAULTS=bedrock_timeout make up`), never in `.env`, and never in prod.
# FAULTS=
# LLM_DISABLED=true
# Route turns to the tool-using agent (default off: the NLU pipeline answers).
# AGENT_ENABLED=true
# Directory holding the learned intent classifier bundle (degraded mode); the default is ml/intent/models.
# INTENT_MODEL_DIR=
TURN_CAP_PER_CONVERSATION=40
TURN_CAP_PER_ACCOUNT_DAY=150
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# --- Analytics (ADR-033) -------------------------------------------------------
# The worker that turns finished conversations into analytics rows.
ANALYTICS_IDLE_MINUTES=30
ANALYTICS_WORKER_INTERVAL_S=120
ANALYTICS_TIMEZONE=America/Bogota
# Seeds mock interactions (source='mock') for the dashboard demo.
ANALYTICS_MOCK_ENABLED=true
ANALYTICS_MOCK_BACKFILL_DAYS=30
